{
  "name": "date-format-plugin",
  "version": "0.0.11",
  "description": "Lightweight, SSR-safe Vue 3 date formatting plugin with Composition API, Options API, and directive support. Multi-locale, timezone-aware date formatting built on the native Intl API, with full TypeScript types.",
  "author": {
    "name": "Mahdi Mohamadzadeh",
    "email": "prowebsi998@gmail.com",
    "url": "https://github.com/mahdimohamadzadeh"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/mahdimohamadzadeh/date-format-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdimohamadzadeh/date-format-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/mahdimohamadzadeh/date-format-plugin/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "date-format-plugin",
    "date-format",
    "date-formatting",
    "date",
    "time",
    "datetime",
    "formatter",
    "intl",
    "i18n",
    "l10n",
    "localization",
    "locale",
    "timezone",
    "vue-plugin",
    "vue-directive",
    "composition-api",
    "typescript",
    "ssr"
  ],
  "main": "./dist/date-format-plugin.umd.cjs",
  "module": "./dist/date-format-plugin.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/date-format-plugin.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/date-format-plugin.umd.cjs"
      }
    }
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "vite-build": "vite build",
    "build": "vite build && vue-tsc --emitDeclarationOnly && node -e \"fs.readdirSync('dist').filter(f=>f.endsWith('.d.ts')).forEach(f=>fs.copyFileSync('dist/'+f,'dist/'+f.replace(/\\.d\\.ts$/,'.d.cts')))\"",
    "pub": "npm run build && npm version patch --force && npm publish",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.19",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.14",
    "vitest": "^4.1.11",
    "vue": "^3.4.25",
    "vue-router": "^4.2.5",
    "vue-tsc": "^2.2.0",
    "vue3-lottie": "^3.2.0"
  }
}
